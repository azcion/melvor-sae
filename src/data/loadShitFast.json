        "id": "ComboDefensive",
        "description": "An effect that applies stacks of modifiers. Stacks are increased by 1 each time the character evades an attack. Stacks are decreased by 1 each time the character is hit by an attack.",
        "baseEffectData": {
          "turnText": "statGroup.stacks",
          "tooltipSpans": [
            {
              "type": "Stats",
              "statGroupName": "stacks"
            },
            {
              "type": "StacksWithMax",
              "stacks": "statGroup.stacks",
              "maxStacks": "p.maxStacks"
            }
          ],
          "descriptionTemplateData": {
            "initialParameters": {
              "maxStacks": "maxStacks"
            },
            "statGroups": {
              "": "stacks"
            }
          },
          "target": "Self",
          "behaviours": [
            {
              "type": "ModifyStats",
              "statGroupName": "stacks",
              "newValue": "min(statGroup.stacks + 1, p.maxStacks)",
              "triggersOn": [
                {
                  "type": "EvadedAttack"
                }
              ]
            },
            {
              "type": "ModifyStats",
              "statGroupName": "stacks",
              "newValue": "statGroup.stacks - 1",
              "triggersOn": [
                {
                  "type": "HitByAttack"
                }
              ]
            }
          ]
        }
      }
